+class Qwen4ExpPackedPinnedHostEmbedding(VocabParallelEmbedding):
+    """Block-16 signed INT4 PLE table read directly from pinned host memory."""
+
+    _COPIED_ATTRIBUTES = Qwen4ExpPinnedHostEmbedding._COPIED_ATTRIBUTES
+    _GROUP_SIZE = 16
+
+    def __init__(self, embedding: VocabParallelEmbedding) -> None:
+        nn.Module.__init__(self)
+        if not isinstance(embedding.quant_method, UnquantizedEmbeddingMethod):
+            raise NotImplementedError(
+                "packed PLE offload requires an unquantized source embedding"
+            )
+        if embedding.weight.dtype != torch.float8_e4m3fn:
+            raise TypeError(
+                "packed PLE offload requires fp8 source weights, got "
+                f"{embedding.weight.dtype}"
+            )
+        if embedding.num_added_embeddings:
+            raise NotImplementedError(
+                "packed PLE offload does not support added vocabulary rows"
+            )
+        if embedding.embedding_dim % self._GROUP_SIZE or embedding.embedding_dim % 2:
+            raise ValueError(
+                "packed PLE offload requires embedding_dim divisible by 16"
+            )
+        for name in self._COPIED_ATTRIBUTES:
+            setattr(self, name, getattr(embedding, name))
+        self.quant_method = None
+        self.groups_per_row = self.embedding_dim // self._GROUP_SIZE
+        self.packed_dim = self.embedding_dim // 2
+        source_weight = embedding.weight
+        rows = source_weight.shape[0]
+
+        packed_weight = nn.Parameter(
+            torch.empty(
+                (rows, self.packed_dim),
+                dtype=torch.uint8,
+                device="cpu",
+                pin_memory=True,
+            ),
+            requires_grad=False,
+        )
+        packed_weight.weight_loader = self.weight_loader
+        self.register_parameter("weight", packed_weight)
+        self.register_buffer(
+            "block_scales",
+            torch.empty(
+                (rows, self.groups_per_row),
+                dtype=torch.float8_e4m3fn,
+                device="cpu",
+                pin_memory=True,
+            ),
+            persistent=False,
+        )
+        self.register_buffer(
+            "weight_scale", embedding.weight_scale, persistent=True
+        )
+        del embedding.weight
+        del source_weight
+        torch.cuda.empty_cache()
+        self._block_d = triton.next_power_of_2(self.embedding_dim)
+        self._chunk_rows = max(
+            1, int(os.environ.get("SGLANG_QWEN4_PLE_W4_CHUNK_ROWS", "262144"))
+        )
+        logger.info(
+            "Allocated packed PLE host table: rows=%d dim=%d packed=%.3f GiB "
+            "scales=%.3f GiB chunk_rows=%d",
+            rows,
+            self.embedding_dim,
+            self.weight.numel() / (1024**3),
+            self.block_scales.numel() / (1024**3),
+            self._chunk_rows,
+        )
+
+    @torch.no_grad()
+    def load_fp8_rows(self, source: torch.Tensor, dst_start: int) -> None:
+        if source.dtype != torch.float8_e4m3fn:
+            raise TypeError(
+                f"packed PLE source shard must be fp8 e4m3, got {source.dtype}"
+            )
+        if source.ndim != 2 or source.shape[1] != self.embedding_dim:
+            raise ValueError(
+                "packed PLE source shape mismatch: "
+                f"{tuple(source.shape)} vs (*, {self.embedding_dim})"
+            )
+        total = source.shape[0]
+        if dst_start < 0 or dst_start + total > self.weight.shape[0]:
+            raise ValueError(
+                f"packed PLE destination out of range: {dst_start}+{total}"
+            )
+        device = torch.device("cuda", torch.cuda.current_device())
+        for offset in range(0, total, self._chunk_rows):
+            count = min(self._chunk_rows, total - offset)
+            x = source[offset : offset + count].to(
+                device=device, dtype=torch.float32, non_blocking=False
+            )
+            blocks = x.reshape(count, self.groups_per_row, self._GROUP_SIZE)
+            max_positive = blocks.clamp_min(0).amax(dim=-1) / 7.0
+            max_negative = (-blocks.clamp_max(0)).amax(dim=-1) / 8.0
+            scale = torch.maximum(max_positive, max_negative).clamp_min(2**-9)
+            scale_fp8 = scale.to(torch.float8_e4m3fn)
+            q = torch.round(blocks / scale_fp8.float().unsqueeze(-1))
+            q = q.clamp(-8, 7).to(torch.int16).reshape(count, self.embedding_dim)
+            lo = q[:, 0::2] & 0xF
+            hi = (q[:, 1::2] & 0xF) << 4
+            packed = (lo | hi).to(torch.uint8)
+            dst = slice(dst_start + offset, dst_start + offset + count)
+            self.weight.data[dst].copy_(packed, non_blocking=False)
+            self.block_scales[dst].copy_(scale_fp8, non_blocking=False)
+            del x, blocks, max_positive, max_negative, scale, scale_fp8, q, packed
+        torch.cuda.empty_cache()
+
+    def allocate_output(
+        self, shape: Tuple[int, ...], device: torch.device
+    ) -> torch.Tensor:
+        allocation_context = nullcontext()
+        if self.tp_size > 1:
+            allocation_context = use_symmetric_memory(
+                get_tp_group(), disabled=not is_allocation_symmetric()
+            )
+        with allocation_context, torch.inference_mode(False):
+            return torch.empty(shape, dtype=torch.bfloat16, device=device)
+
+    def gather(
+        self, input_ids: torch.Tensor, out: Optional[torch.Tensor] = None
+    ) -> torch.Tensor:
+        expected_shape = (*input_ids.shape, self.embedding_dim)
+        if out is None:
+            output = self.allocate_output(expected_shape, input_ids.device)
+        else:
+            if tuple(out.shape) != expected_shape:
+                raise ValueError(
+                    f"invalid packed PLE output shape: {tuple(out.shape)} != "
+                    f"{expected_shape}"
+                )
+            if out.dtype != torch.bfloat16 or out.device != input_ids.device:
+                raise ValueError(
+                    "packed PLE output must be bfloat16 on the id device"
+                )
+            output = out
+
+        flat_ids = input_ids.reshape(-1).long()
+        if flat_ids.numel():
+            _gather_ple_embedding_from_pinned_w4_kernel[(flat_ids.numel(),)](
+                self.weight.data_ptr(),
+                self.block_scales.data_ptr(),
+                flat_ids,
+                output,
+                embedding_dim=self.embedding_dim,
+                groups_per_row=self.groups_per_row,
+                tp_vocab_start=self.shard_indices.org_vocab_start_index,
+                tp_vocab_end=self.shard_indices.org_vocab_end_index,
+                BLOCK_D=self._block_d,
+            )
+        return output
+
+    def reduce(self, output: torch.Tensor) -> torch.Tensor:
+        if self.tp_size > 1 and not get_attn_tp_context().input_scattered:
+            if self.use_attn_tp_group:
+                return attn_tp_all_reduce(output)
+            return tensor_model_parallel_all_reduce(output)
+        return output
+
+    def forward(self, input_ids: torch.Tensor) -> torch.Tensor:
+        return self.reduce(self.gather(input_ids))
+
